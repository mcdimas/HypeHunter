:80 {
	encode zstd gzip

	handle /api/auth/email/* {
		request_body {
			max_size 8KB
		}
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /media/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Proxy-By "Caddy"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
